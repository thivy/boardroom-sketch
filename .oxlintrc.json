{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./packages/tooling/oxlint.json"],
  "ignorePatterns": [
    "**/.output/**",
    "**/dist/**",
    "**/build/**",
    "**/routeTree.gen.ts",
    ".agents/**"
  ],
  "overrides": [
    {
      "files": ["**/*.{js,jsx,mjs,ts,tsx,mts,cts}"],
      "rules": {
        "react/display-name": "error",
        "react/jsx-key": "error",
        "react/jsx-no-comment-textnodes": "error",
        "react/jsx-no-duplicate-props": "error",
        "react/jsx-no-target-blank": "off",
        "react/jsx-no-undef": "error",
        "react/no-children-prop": "error",
        "react/no-danger-with-children": "error",
        "react/no-direct-mutation-state": "error",
        "react/no-find-dom-node": "error",
        "react/no-is-mounted": "error",
        "react/no-render-return-value": "error",
        "react/no-string-refs": "error",
        "react/no-unescaped-entities": "error",
        "react/no-unknown-property": "off",
        "react/no-unsafe": "off",
        "react/react-in-jsx-scope": "off",
        "import/no-anonymous-default-export": "warn",
        "react/rules-of-hooks": "error",
        "react/exhaustive-deps": "warn",
        "react/static-components": "error",
        "react/use-memo": "error",
        "react/preserve-manual-memoization": "error",
        "react/incompatible-library": "warn",
        "react/immutability": "error",
        "react/globals": "error",
        "react/refs": "error",
        "react/set-state-in-effect": "error",
        "react/error-boundaries": "error",
        "react/purity": "error",
        "react/set-state-in-render": "error",
        "react/unsupported-syntax": "warn"
      },
      "globals": {
        "AudioWorkletGlobalScope": "readonly",
        "AudioWorkletProcessor": "readonly",
        "currentFrame": "readonly",
        "currentTime": "readonly",
        "registerProcessor": "readonly",
        "sampleRate": "readonly",
        "WorkletGlobalScope": "readonly"
      },
      "plugins": ["react", "import"],
      "env": {
        "browser": true,
        "node": true
      }
    },
    {
      "files": ["**/*.ts", "**/*.tsx", "**/*.mts", "**/*.cts"],
      "rules": {
        "constructor-super": "off",
        "getter-return": "off",
        "no-class-assign": "off",
        "no-const-assign": "off",
        "no-dupe-class-members": "off",
        "no-dupe-keys": "off",
        "no-func-assign": "off",
        "no-import-assign": "off",
        "no-new-native-nonconstructor": "off",
        "no-obj-calls": "off",
        "no-redeclare": "off",
        "no-setter-return": "off",
        "no-this-before-super": "off",
        "no-unreachable": "off",
        "no-unsafe-negation": "off",
        "no-var": "error",
        "no-with": "off",
        "prefer-const": "error",
        "prefer-rest-params": "error",
        "prefer-spread": "error"
      }
    },
    {
      "files": ["**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "importNames": ["useState", "useReducer", "default"],
                "message": "Client state lives in a Zustand store (see createStore in packages/features/src/shared/client). Do not use useState or useReducer."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/ui/src/components/**/*.tsx"],
      "rules": { "no-restricted-imports": "off" }
    },
    {
      "files": ["packages/{teams-cdp,storage-sqlite,copilot-sdk}/src/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@app/features",
                  "@app/features/**",
                  "@app/ui",
                  "@app/ui/**",
                  "react",
                  "react-dom",
                  "@tanstack/*"
                ],
                "message": "Adapters only implement a port from @app/contracts; they know nothing about features, UI or web frameworks."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/features/src/*/server/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "react",
                  "react/*",
                  "react-dom",
                  "lucide-react",
                  "@tanstack/*",
                  "@app/ui",
                  "@app/ui/**",
                  "@app/teams-cdp",
                  "@app/teams-cdp/**",
                  "@app/storage-sqlite",
                  "@app/storage-sqlite/**",
                  "@app/copilot-sdk",
                  "@app/copilot-sdk/**",
                  "@github/copilot-sdk",
                  "../client",
                  "../client/**",
                  "../../captions/**",
                  "../../chat/**",
                  "../../graph/**",
                  "../../updates/**"
                ],
                "message": "Feature servers run without a UI and know only the ports in @app/contracts and what is in features/src/shared; the app wires adapters in (apps/web/src/*-handlers.ts). Features do not import each other."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "importNames": ["useState", "useReducer", "default"],
                "message": "Client state lives in a Zustand store (see createStore in packages/features/src/shared/client). Do not use useState or useReducer."
              }
            ],
            "patterns": [
              {
                "group": ["node:*", "fs", "path", "os", "@github/copilot-sdk", "@app/contracts"],
                "message": "apps/web holds framework code only. Features (including prompts, config and business logic) live in packages/features; the web app only routes to them and wires adapters in *-handlers.ts."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/features/src/*/client/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "importNames": ["useState", "useReducer", "default"],
                "message": "Client state lives in a Zustand store (see createStore in packages/features/src/shared/client). Do not use useState or useReducer."
              }
            ],
            "patterns": [
              {
                "group": [
                  "../server",
                  "../server/**",
                  "@github/copilot-sdk",
                  "../../captions/**",
                  "../../chat/**",
                  "../../graph/**",
                  "../../updates/**"
                ],
                "message": "Feature clients must not import server code, or another feature; share types through @app/contracts and code through features/src/shared."
              }
            ]
          }
        ]
      }
    }
  ]
}
