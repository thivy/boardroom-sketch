{
  "name": "boardroom-sketch",
  "version": "0.1.0",
  "description": "Boardroom Sketch app shell",
  "license": "MIT",
  "repository": "github:thivy/boardroom-sketch",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "start": "bun run --cwd apps/web start",
    "lint": "bun run --cwd packages/tooling lint",
    "lint:fix": "bun run --cwd packages/tooling lint:fix",
    "lint:types": "bun run --cwd packages/tooling lint:types",
    "fmt": "bun run --cwd packages/tooling fmt",
    "fmt:check": "bun run --cwd packages/tooling fmt:check",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "desktop:dev": "bun run --cwd apps/desktop dev",
    "desktop:dev:built": "bun run --cwd apps/desktop dev:built",
    "desktop:build": "bun run --cwd apps/desktop build",
    "desktop:release": "bun run --cwd apps/desktop build:release"
  },
  "dependencies": {
    "@github/copilot-sdk": "^1.0.34"
  },
  "devDependencies": {
    "@app/tooling": "workspace:*",
    "@types/bun": "^1.4.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4"
}
