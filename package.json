{
  "name": "boardroom-sketch",
  "version": "0.1.0",
  "description": "Boardroom Sketch app shell",
  "license": "MIT",
  "repository": "github:thivy/boardroom-sketch",
  "bin": {
    "boardroom-sketch": "bin/boardroom-sketch.mjs"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "files": [
    "bin",
    "apps/web/.output"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "start": "bun run --cwd apps/web start",
    "prepack": "bun run build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test",
    "desktop:dev": "bun run --cwd apps/desktop dev",
    "desktop:build": "bun run --cwd apps/desktop build"
  },
  "devDependencies": {
    "@types/bun": "^1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.4"
}
