{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The window loads the local app server, which may check for updates and restart the app.",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": ["core:default", "updater:default", "process:allow-restart"]
}
