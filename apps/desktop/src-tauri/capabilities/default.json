{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The window loads the local app server, which may check for updates and restart the app.",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "updater:default",
    "process:allow-restart"
  ]
}
