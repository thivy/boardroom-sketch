{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Boardroom Sketch",
  "version": "0.1.0",
  "identifier": "dev.thivy.boardroomsketch",
  "build": {
    "frontendDist": "../loading"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Boardroom Sketch",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/node"],
    "resources": {
      "server": "server"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA5QjA4MEMyRUQ3RkNBMTEKUldRUnluL3R3b0N3Q2UxQi8vbnVmbXJLMWM3Q0RFTG96YUlDMlVFU2pja05HQVlEVlRmMytKamMK",
      "endpoints": [
        "https://github.com/thivy/boardroom-sketch/releases/latest/download/latest.json"
      ]
    }
  }
}
