{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Boardroom Sketch",
  "version": "0.1.0",
  "identifier": "dev.thivy.boardroomsketch",
  "build": {
    "frontendDist": "../loading"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Boardroom Sketch",
        "width": 1200,
        "height": 800
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/node"],
    "resources": { "server": "server" }
  }
}
